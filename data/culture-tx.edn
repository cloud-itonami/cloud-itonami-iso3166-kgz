#:culture{:id "kgz.dish.manti", :name "Manti", :country "KGZ", :kind :dish, :summary "Steamed dumpling of spiced meat wrapped in thin dough, found across Central Asian cuisines including Kyrgyz cuisine, typically cooked in a multi-level steamer.", :url "https://en.wikipedia.org/wiki/Manti_(food)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
