#:culture{:url "https://en.wikipedia.org/wiki/Kumis", :id "kgz.beverage.kumis", :kind :beverage, :name-local "кымыз", :country "KGZ", :retrieved-at "2026-07-17", :summary "Traditional fermented dairy product made from mare's milk, holding significant cultural importance in Kyrgyzstan, where the capital Bishkek is supposedly named after the paddle used to churn the fermenting milk.", :name "Kumis", :url-provenance :wikipedia-en}
